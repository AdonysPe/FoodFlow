// FoodFlow data model. Postgres (e.g. Neon) — required in production since
// Vercel's serverless functions have a read-only filesystem, so a local
// SQLite file can't be written to. Point DATABASE_URL at your instance.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (PgBouncer) doesn't support the advisory locks
  // `prisma migrate` needs, so migrations run over the direct connection.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  admin
  client
}

enum LeadStatus {
  new
  contacted
  converted
}

enum OrderStatus {
  pending
  preparing
  ready
  delivered
}

enum OrderChannel {
  dine_in
  delivery
  pickup
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  role        UserRole     @default(client)
  createdAt   DateTime     @default(now())
  restaurants Restaurant[]
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  orders    Order[]
  menuItems MenuItem[]
  customers Customer[]

  @@index([ownerId])
}

// `items` is a JSON snapshot of the order lines (name/price/quantity) taken
// at order time, so later menu price edits never rewrite historical orders.
model Order {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  customerName String
  items        Json
  total        Float
  channel      OrderChannel @default(dine_in)
  status       OrderStatus  @default(pending)
  // Set the moment status flips to "ready" — lets us compute an accurate
  // average prep time without a separate status-history table.
  readyAt      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model MenuItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  price        Float
  category     String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  email        String?
  phone        String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

model ClientLead {
  id        String     @id @default(cuid())
  email     String
  source    String     @default("landing")
  status    LeadStatus @default(new)
  createdAt DateTime   @default(now())

  @@index([email])
  @@index([status])
}

// One row per requested OTP. The `code` column stores a salted hash, never
// the plaintext digits. `attempts` guards against brute-forcing a 6-digit
// code within the 5-minute expiry window.
model OTPCode {
  id         String    @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}
