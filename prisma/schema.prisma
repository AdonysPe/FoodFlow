// FoodFlow data model. Postgres (e.g. Neon) — required in production since
// Vercel's serverless functions have a read-only filesystem, so a local
// SQLite file can't be written to. Point DATABASE_URL at your instance.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (PgBouncer) doesn't support the advisory locks
  // `prisma migrate` needs, so migrations run over the direct connection.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  admin
  client
}

enum LeadStatus {
  new
  contacted
  converted
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  role        UserRole     @default(client)
  createdAt   DateTime     @default(now())
  restaurants Restaurant[]
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model ClientLead {
  id        String     @id @default(cuid())
  email     String
  source    String     @default("landing")
  status    LeadStatus @default(new)
  createdAt DateTime   @default(now())

  @@index([email])
  @@index([status])
}

// One row per requested OTP. The `code` column stores a salted hash, never
// the plaintext digits. `attempts` guards against brute-forcing a 6-digit
// code within the 5-minute expiry window.
model OTPCode {
  id         String    @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}
