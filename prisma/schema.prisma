// FoodFlow data model. Postgres (e.g. Neon) — required in production since
// Vercel's serverless functions have a read-only filesystem, so a local
// SQLite file can't be written to. Point DATABASE_URL at your instance.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (PgBouncer) doesn't support the advisory locks
  // `prisma migrate` needs, so migrations run over the direct connection.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  admin
  client
  // A waiter. Belongs to one restaurant via StaffMembership and only ever
  // sees the mobile comanda screen — never the owner dashboard.
  mozo
}

enum LeadStatus {
  new
  contacted
  converted
}

enum OrderStatus {
  pending
  preparing
  ready
  delivered
}

enum OrderChannel {
  dine_in
  delivery
  pickup
}

enum PaymentMethod {
  efectivo
  // `tarjeta` predates the split into credit/debit and is kept so orders
  // charged before it stay readable. New charges pick one of the two below.
  tarjeta
  tarjeta_credito
  tarjeta_debito
  yape
  transferencia
  mixto
}

/// What the diner is handed when the table is charged.
///
/// `nota_venta` is the internal control document FoodFlow has always printed.
/// The other two are SUNAT comprobantes and only earn their name once the OSE
/// answers: an order asking for a boleta whose emission failed still prints a
/// nota de venta (see `Order.sunatStatus`).
enum DocumentType {
  nota_venta
  boleta
  factura
}

// The commercial plan a restaurant is on. Set by a FoodFlow admin when the
// client signs up; it decides which dashboard modules they can open.
enum Plan {
  carta
  servicio
  negocio
}

enum BillingStatus {
  pending
  active
  cancelled
}

enum TableShape {
  round
  square
  rect
}

enum TableZone {
  salon
  terraza
  barra
}

enum ReservationStatus {
  pendiente
  confirmada
  sentada
  cancelada
  no_show
}

enum ReservationSource {
  manual
  web
}

model User {
  id                        String            @id @default(cuid())
  email                     String            @unique
  role                      UserRole          @default(client)
  passwordHash              String?           @map("password_hash")
  verificationCode          String?           @map("verification_code")
  verificationCodeExpiresAt DateTime?         @map("verification_code_expires_at")
  passwordResetAt           DateTime?         @map("password_reset_at")
  passwordResetAttempts     Int               @default(0) @map("password_reset_attempts")
  requiresPasswordSetup     Boolean           @default(false) @map("requires_password_setup")
  sessionVersion            Int               @default(0) @map("session_version")
  failedLoginAttempts       Int               @default(0) @map("failed_login_attempts")
  loginLockedUntil          DateTime?         @map("login_locked_until")
  createdAt                 DateTime          @default(now())
  restaurants               Restaurant[]
  staffMemberships          StaffMembership[]
}

// Links a mozo (or, later, other staff roles) to the restaurant they work at.
// The owner adds a person by email; that person then logs in with the normal
// email/password flow and lands on the comanda.
model StaffMembership {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, userId])
  @@index([userId])
}

model Restaurant {
  id            String        @id @default(cuid())
  name          String
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id])
  // Defaults to the smallest plan on purpose: a restaurant never gets paid
  // modules by accident, the admin has to grant them.
  plan          Plan          @default(carta)
  billingStatus BillingStatus @default(pending) @map("billing_status")
  // Public address of this venue's carta: /carta/<slug>, and the host that
  // <slug>.foodflow.site rewrites to. Nullable because a venue exists before
  // anyone has published its menu.
  slug          String?       @unique
  // Bumped by every write that changes what a diner sees. Lives here rather
  // than on CartaSettings so bumping is one guaranteed update with no upsert,
  // and so the live-update watcher reads a single row by primary key.
  cartaVersion  Int           @default(0)
  createdAt     DateTime      @default(now())

  orders       Order[]
  menuItems    MenuItem[]
  categories   MenuCategory[]
  customers    Customer[]
  tables       RestaurantTable[]
  reservations Reservation[]
  staff        StaffMembership[]
  receipt      ReceiptSettings?
  carta        CartaSettings?
  billing      BillingCredentials?
  cdrs         Cdr[]

  @@index([ownerId])
}

/// What the venue prints when a waiter charges a table, plus the running
/// correlative for those documents.
///
/// Kept out of `Restaurant` on purpose: the restaurant row is read on every
/// dashboard request by the session guard, while these columns are only
/// needed on the receipt itself and on its settings page.
model ReceiptSettings {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  // Printed header. All optional — a venue with none of it still gets a
  // usable ticket with its trade name on top.
  legalName  String?
  ruc        String?
  address    String?
  phone      String?
  footerNote String?

  // 58 or 80, the two thermal roll widths sold in Peru.
  paperWidth Int     @default(80)
  // Off by default: a venue not registered for IGV must not print a tax
  // breakdown, and we cannot know its regime.
  showIgv    Boolean @default(false)
  igvRate    Float   @default(0.18)
  // Send the ticket straight to the print dialog after charging.
  autoPrint  Boolean @default(true)

  // Prefix and running number of the internal nota de venta.
  series  String @default("NV01")
  counter Int    @default(0)

  // ---------------------------------------------------- facturación electrónica
  // Everything below is what an OSE needs to emit on this venue's behalf. It
  // is the venue's own SUNAT identity: FoodFlow neither owns nor pays for it,
  // it only stores what the owner typed in Configuración > Facturación.

  /// Nombre comercial. Defaults to the restaurant name when blank.
  tradeName  String?
  /// Where SUNAT and the OSE send notices about this taxpayer.
  sunatEmail String?

  /// Series and correlatives, one running counter per document type. Kept
  /// apart from the nota de venta counter because SUNAT numbers each series
  /// independently and a gap in either one has to be explainable.
  boletaSeries   String @default("B001")
  boletaCounter  Int    @default(0)
  facturaSeries  String @default("F001")
  facturaCounter Int    @default(0)
  creditSeries   String @default("FC01")
  creditCounter  Int    @default(0)

  /// Which OSE/PSE this venue contracted. Non-secret, so it lives here next
  /// to the rest of the configuration; the key and secret do not.
  oseProvider String?
  /// The account's own API endpoint. Nubefact hands each taxpayer a distinct
  /// URL, so this cannot be a constant baked into the provider catalogue.
  oseEndpoint String?

  /// Ticket look. The logo is stored as a data URL already downscaled to
  /// thermal-printer size in the browser, so it never grows past a few KB.
  logoDataUrl     String?
  showQr          Boolean @default(true)
  showCustomerRuc Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The two things a venue must hand FoodFlow for an OSE to sign on its behalf:
/// the digital certificate and the API credentials. Both are stored encrypted
/// (AES-256-GCM, see lib/billing/crypto.ts) and live in their own table so no
/// other query can pull them in by accident — the receipt path, the comanda
/// and the settings form all read `ReceiptSettings` and never touch this.
model BillingCredentials {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  /// Credentials of the venue's own OSE account. The venue pays the OSE
  /// directly; FoodFlow only presents these when emitting on its behalf.
  oseApiKeyEnc    String?
  oseApiSecretEnc String?
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?

  /// The .pfx/.p12 itself, encrypted, plus what could be read out of it when
  /// it was uploaded. Subject and expiry are cached because opening the
  /// container costs a decryption and the settings page shows them on load.
  certFileName    String?
  certDataEnc     String?
  certPasswordEnc String?
  certSubject     String?
  certExpiresAt   DateTime?
  certUploadedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The answer SUNAT gave about one comprobante, kept as its own archive.
///
/// WHY A SEPARATE TABLE. `Order` already carries `sunatStatus` and the number
/// the till printed, and that is what the receipt reads. But the CDR is a tax
/// record, not an order field: SUNAT expects the issuer to keep the XML it
/// sent and the response it got for five years, the row has to survive an
/// order being edited or a menu item being renamed, and "list what I issued in
/// March" must never turn into a scan of every order ever charged.
///
/// One row is created the moment a correlative is drawn — `PENDIENTE`, before
/// the OSE has answered — so a number can never be burned without a trace of
/// what it was burned on. It then moves to ACEPTADO or RECHAZADO exactly once.
enum CdrEstado {
  /// Number drawn and XML built; the OSE has not answered yet, or the call
  /// failed for a reason worth retrying (timeout, 5xx, no network).
  PENDIENTE
  /// SUNAT took it. The ONLY state that lets a ticket call itself a boleta.
  ACEPTADO
  /// SUNAT refused it. Terminal: the correlative is spent and the fix is a
  /// new document, never a retry of this one.
  RECHAZADO
}

model Cdr {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  /// The charge this comprobante was issued for. Nullable only so a document
  /// emitted outside the till (a manual re-issue) still has somewhere to live.
  orderId      String?    @map("order_id")
  order        Order?     @relation(fields: [orderId], references: [id])

  /// Catálogo 01 de SUNAT: "01" factura, "03" boleta, "07" nota de crédito.
  tipoDocumento   String @map("tipo_documento") @db.VarChar(2)
  serie           String @map("serie") @db.VarChar(10)
  /// Zero-padded to 8, the way it is printed: "00000123".
  correlativo     String @map("correlativo") @db.VarChar(10)
  /// "B001-00000123". Denormalized because it is what a human searches for.
  numeroDocumento String @map("numero_documento") @db.VarChar(20)

  /// Catálogo 06: "1" DNI, "6" RUC, "0" when the diner gave nothing.
  clienteTipoDocumento   String? @map("cliente_tipo_documento") @db.VarChar(2)
  clienteNumeroDocumento String? @map("cliente_numero_documento") @db.VarChar(20)
  clienteDenominacion    String? @map("cliente_denominacion") @db.VarChar(255)
  /// Where the PDF/XML gets sent. Copied off the order so a later edit to the
  /// customer record cannot change who a past comprobante was mailed to.
  clienteEmail           String? @map("cliente_email") @db.VarChar(255)

  /// Digest of the signed XML, from the OSE. Goes inside the QR square.
  hash       String? @db.VarChar(255)
  /// The signed XML itself when the provider returns it inline; otherwise the
  /// link below is the copy of record and this stays null.
  xmlContent String? @map("xml_content") @db.Text
  xmlUrl     String? @map("xml_url") @db.VarChar(500)
  pdfUrl     String? @map("pdf_url") @db.VarChar(500)
  /// Where `backupCDRs` parked the archive. Null until the job has run.
  backupUrl  String? @map("backup_url") @db.VarChar(500)

  estado       CdrEstado @default(PENDIENTE)
  /// Verbatim from the OSE, in Spanish. This sentence is what the waiter reads
  /// on the till and what the owner reads in the CDR list, so it is never
  /// rewritten into a code.
  mensajeSunat String?   @map("mensaje_sunat") @db.Text
  /// SUNAT's own response code (e.g. "0", "2335"). 4-digit codes in the 2000s
  /// are rejections, the 4000s are observations.
  codigoSunat  String?   @map("codigo_sunat") @db.VarChar(10)

  fechaEmision DateTime @map("fecha_emision")
  /// Money as sent. Decimal, not Float: a comprobante that says 45.29 must
  /// still say 45.29 after a round trip through the database.
  total        Decimal  @db.Decimal(10, 2)
  gravada      Decimal? @db.Decimal(10, 2)
  igv          Decimal? @db.Decimal(10, 2)

  /// Retry bookkeeping for `retryFailedEmissions`. `attempts` is why a row
  /// stops being retried instead of being hammered forever.
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  /// When the PDF/XML actually left for the customer.
  emailedAt     DateTime? @map("emailed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// A correlative belongs to exactly one document, forever. This constraint is
  /// the last line of defence against the one error SUNAT does not forgive:
  /// two comprobantes sent under the same number.
  @@unique([restaurantId, serie, correlativo])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, estado])
  @@index([orderId])
  @@map("cdrs")
}

// `items` is a JSON snapshot of the order lines (name/price/quantity) taken
// at order time, so later menu price edits never rewrite historical orders.
model Order {
  id             String           @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  customerName   String
  items          Json
  total          Float
  channel        OrderChannel     @default(dine_in)
  status         OrderStatus      @default(pending)
  // Incremented each time a server sends another round of items to an
  // already-open order for the same table, instead of opening a new order.
  roundNumber    Int              @default(1)
  // Display name of the waiter who placed / last added to the order. Shown on
  // the kitchen board. Null for orders logged from the owner dashboard.
  serverName     String?
  // Optional link to a floor-plan table. Nullable and unset by the existing
  // order flow — the Mesas module uses it to show a table's active order.
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  // Set the moment status flips to "ready" — lets us compute an accurate
  // average prep time without a separate status-history table.
  readyAt        DateTime?
  // Payment is tracked separately from the kitchen status. A dine-in order
  // keeps its table occupied until it is paid (paidAt) or voided (voidedAt).
  // For cash, amountReceived/changeGiven record the tendered amount and change.
  paidAt         DateTime?
  paymentMethod  PaymentMethod?
  amountReceived Float?
  changeGiven    Float?
  // The number printed on the receipt, assigned once when the order is
  // charged. Series and number are copied onto the order rather than read
  // back from settings, so reprinting a ticket years later reproduces the
  // paper the diner was handed, not today's configuration.
  receiptSeries  String?
  receiptNumber  Int?

  // What the diner asked for at the till and who it is made out to. Stored on
  // the order rather than looked up later for the same reason as the series:
  // the paper handed over has to be reproducible years afterwards.
  documentType   DocumentType?
  // Series and correlative of the ELECTRONIC comprobante, drawn from its own
  // counter. Separate from receiptSeries/receiptNumber above, which number the
  // internal nota de venta: a boleta that SUNAT rejected has both — the number
  // it was sent under, and the internal document actually handed over.
  docSeries      String?
  docNumber      Int?
  billingDocType String? // "dni" | "ruc"
  billingDocId   String?
  billingName    String?
  billingAddress String?
  billingEmail   String?
  // Result of the emission attempt. Null on every order charged as an
  // internal nota de venta; "aceptado" is the ONLY value that lets the ticket
  // call itself a boleta or factura electrónica.
  sunatStatus    String?
  sunatHash      String?
  sunatMessage   String?
  sunatLink      String?
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cdrs           Cdr[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([tableId])
}

// Menu categories are seeded per restaurant (Entradas, Principales,
// Guarniciones, Bebidas, Postres) and fully editable. `sortOrder` drives the
// tab order in the admin and the section order on the public menu; `active`
// hides the whole category (and its items) from ordering without deleting it.
model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  sortOrder    Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@index([restaurantId])
}

// `available` is the quick "Disponible / Agotado" toggle — an agotado item
// still shows in the admin but can't be added to an order or the public menu.
// `sortOrder` is the manual drag order within its category.
model MenuItem {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  categoryId   String?
  category     MenuCategory? @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  price        Float
  photoUrl     String?
  prepMin      Int?
  available    Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([restaurantId])
  @@index([categoryId])
}

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  email        String?
  phone        String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

// A table on the restaurant floor plan. `x`/`y` are stored as RELATIVE
// coordinates — percentages 0-100 of the canvas width/height — so the plan
// stays responsive and renders identically on any screen size.
model RestaurantTable {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  name         String
  capacity     Int           @default(2)
  shape        TableShape    @default(round)
  zone         TableZone     @default(salon)
  x            Float         @default(50)
  y            Float         @default(50)
  active       Boolean       @default(true)
  // Set when a server marks the table occupied from the floor plan, cleared
  // when they free it. A linked active order also counts as occupied.
  occupiedAt   DateTime?
  // What the QR on the table encodes. Random rather than the row id so the
  // codes cannot be walked from one table to the next, and stable so a
  // printed QR keeps working. Nullable only until every row is backfilled.
  publicCode   String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  orders       Order[]

  @@index([restaurantId])
}

// `date` is the calendar day (no time component); `startTime` is a local
// "HH:MM" string and `durationMin` gives the end — kept as wall-clock values
// so a pilot restaurant never has to think about timezones. Overlap checks
// live in lib/actions/reservations.ts. Reservations from FoodFlow Sites come
// in with source "web" and status "pendiente" for the admin to confirm.
model Reservation {
  id            String            @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id])
  tableId       String?
  table         RestaurantTable?  @relation(fields: [tableId], references: [id])
  customerName  String
  customerPhone String?
  date          DateTime          @db.Date
  startTime     String
  durationMin   Int               @default(90)
  partySize     Int               @default(2)
  status        ReservationStatus @default(pendiente)
  source        ReservationSource @default(manual)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, date])
  @@index([tableId])
}

model ClientLead {
  id        String     @id @default(cuid())
  email     String
  source    String     @default("landing")
  status    LeadStatus @default(new)
  createdAt DateTime   @default(now())

  // Salted SHA-256 of the caller's IP (never the address), so the public
  // `submitLead` chat escape hatch can be rate limited across cold starts.
  ipHash String? @map("ip_hash")

  @@index([email])
  @@index([status])
  @@index([ipHash, createdAt])
}

// Legacy OTP history kept during the password-auth migration. New reset codes
// are stored hashed in User.verificationCode and never use this table.
model OTPCode {
  id         String    @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// Append-only trail of sensitive actions. Written best-effort (a failed insert
// never blocks the user action). Readable only by the platform operator
// (role "admin"). `ipHash` is the salted hash from lib/security/clientHash —
// never a raw address. `before`/`after` hold just the fields that changed.
model AuditLog {
  id           String   @id @default(cuid())
  action       String // e.g. "auth.login", "menu.item.price_change", "staff.add"
  actorId      String? // User.id; null for anonymous / system
  actorEmail   String? // denormalized so a deleted account still traces
  entity       String? // "MenuItem", "Lead", "Restaurant", …
  entityId     String?
  before       Json?
  after        Json?
  ipHash       String?
  restaurantId String? // tenant scope, when the action belongs to one
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@index([restaurantId, createdAt])
}

// Generic fixed-window rate limiter, DB-backed so it survives cold starts and
// works across serverless instances. `key` is "<bucket>:<subject>:<window>"
// (e.g. "otp-ip:<ipHash>:29876"); `count` is the hits in that window;
// `expiresAt` is when the window closes (also the cue to prune the row).
// See lib/security/rateLimit.ts.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------- leads
// Capture funnel for the Lima pilot. Separate from `ClientLead` (the old
// email-only signup the admin dashboard already lists) because these rows
// carry a whole conversation starter: who they are, which venue, and — when
// the commission calculator produced it — how much they are losing.

enum LeadSource {
  web_form
  calculadora
  whatsapp
}

// The pipeline the owner works through by hand. Spanish on purpose: these
// values are read straight off the admin table.
enum LeadPipelineStatus {
  nuevo
  contactado
  cita
  cliente
  archivado
}

model Lead {
  id          String     @id @default(cuid())
  nombre      String
  restaurante String
  // Peru mobile, 9 digits, stored without the country code.
  whatsapp    String
  email       String?
  source      LeadSource

  // Whole soles, straight from the calculator. Null for every other source.
  perdidaMensual Int? @map("perdida_mensual")
  perdidaAnual   Int? @map("perdida_anual")

  // 0–100. Derived from the yearly loss, so a form-only lead scores 0.
  score  Int                @default(0)
  status LeadPipelineStatus @default(nuevo)

  createdAt DateTime @default(now()) @map("created_at")

  // When the visitor ticked the privacy consent box. Ley 29733 puts the
  // burden of proving consent on us, so the moment it was given is stored
  // rather than a bare boolean.
  consentAt DateTime? @map("consent_at")

  // Salted SHA-256 of the caller's IP, never the address itself. It exists
  // only so the form can be rate limited across cold starts; it cannot be
  // read back into an IP without the server secret.
  ipHash String? @map("ip_hash")

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@map("leads")
}

// ------------------------------------------------- libro de reclamaciones
// Virtual complaints book required of any supplier that sells to consumers in
// Peru (Código de Protección y Defensa del Consumidor, Ley 29571, and its
// reglamento D.S. 011-2011-PCM). Every entry gets a correlative number the
// consumer keeps as proof, and the supplier must answer within the published
// deadline. Rows are never deleted — the record is the compliance.

enum ClaimKind {
  // Disconformidad ligada al producto o servicio contratado.
  reclamo
  // Malestar o descontento ajeno al producto: la atención, el trato.
  queja
}

enum ClaimStatus {
  recibido
  en_proceso
  respondido
}

model Claim {
  id   String @id @default(cuid())
  // Correlative shown to the consumer, e.g. "LR-2026-000012". Unique because
  // it is the number they quote if they escalate to INDECOPI.
  code String @unique

  // Identificación del consumidor — every field required by the regulation.
  nombre    String
  dni       String
  telefono  String
  email     String
  // The existing physical column keeps its original name for a zero-loss,
  // migration-free transition from the former domicilio field.
  distrito String @map("direccion")

  kind    ClaimKind
  // Detalle de la reclamación y, cuando lo indica, lo que el consumidor pide.
  detalle String    @db.Text
  pedido  String?   @db.Text

  status      ClaimStatus @default(recibido)
  // Filled when the supplier answers, which starts the clock on the record.
  respondedAt DateTime?   @map("responded_at")
  respuesta   String?     @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Salted hash of the caller's IP, for rate limiting only. Never an address.
  ipHash String? @map("ip_hash")

  @@index([status])
  @@index([createdAt])
  @@map("complaints")
}

/// How the public carta presents this venue: the header a diner sees above the
/// menu, and whether the menu is visible at all.
///
/// Separate from `Restaurant` for the same reason as ReceiptSettings — the
/// restaurant row is read on every dashboard request by the session guard,
/// while these fields are only needed on the public page and its editor.
model CartaSettings {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  // Off until the owner says so: an unfinished menu should not be reachable
  // by guessing the slug.
  published Boolean @default(false)

  logoUrl  String?
  tagline  String?
  address  String?
  mapsUrl  String?
  // Nine digits, Peru mobile. The floating button builds a wa.me link from it.
  whatsapp String?

  /// Weekly opening hours, as seven entries keyed by weekday (0 = Sunday):
  /// `[{ "day": 0, "closed": true }, { "day": 1, "open": "12:00", "close": "23:00" }]`.
  /// Shape validated in lib/carta.ts, not by Postgres.
  hours Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
