# Copy to .env and fill in real values. Never commit .env.

# Postgres connection strings (e.g. from Neon). Required — Vercel's
# serverless functions can't write to a local SQLite file.
# DATABASE_URL: pooled connection, used by the app at runtime.
# DATABASE_URL_UNPOOLED: direct connection, used only for running migrations.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign session JWTs and pepper OTP hashes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Comma-separated emails that get the "admin" role on first login.
# Everyone else who logs in becomes a "client".
ADMIN_EMAILS="you@example.com"

# Public base URL, used in emails.
APP_URL="http://localhost:3000"

# SMTP config for sending OTP emails. If left unset in development, OTP
# codes are logged to the server console instead of emailed.
#
# Using Resend: SMTP_FROM must be on a domain you've verified in the Resend
# dashboard (Domains -> Add Domain -> add the DNS records it gives you).
# Until that domain shows "Verified", Resend's sandbox mode only delivers to
# the email address your Resend account was signed up with — every other
# recipient silently fails to receive the code.
#
# No domain yet? Gmail SMTP works as a temporary stand-in — it can send to
# any recipient right away, no DNS needed:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="youraccount@gmail.com"
#   SMTP_PASS="<16-char Gmail App Password, not your regular password>"
#   SMTP_FROM="FoodFlow <youraccount@gmail.com>"   (must match SMTP_USER — Gmail rejects a spoofed From)
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled first). Swap back to Resend + your
# own domain before real launch — Gmail has a ~500/day send limit and every
# code will visibly come from your personal address.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FoodFlow <no-reply@foodflow.app>"
