# Copy to .env and fill in real values. Never commit .env.

# Postgres connection strings (e.g. from Neon). Required — Vercel's
# serverless functions can't write to a local SQLite file.
# DATABASE_URL: pooled connection, used by the app at runtime.
# DATABASE_URL_UNPOOLED: direct connection, used only for running migrations.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign session JWTs and pepper OTP hashes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Comma-separated emails that get the "admin" role on first login.
# Everyone else who logs in becomes a "client".
ADMIN_EMAILS="you@example.com"

# Public base URL, used in emails.
APP_URL="http://localhost:3000"

# SMTP config for sending OTP emails. If left unset in development, OTP
# codes are logged to the server console instead of emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FoodFlow <no-reply@foodflow.app>"
