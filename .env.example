# Copy to .env and fill in real values. Never commit .env.

# SQLite for local dev. For production, use a postgresql:// URL and set
# `provider = "postgresql"` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Long random string used to sign session JWTs and pepper OTP hashes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Comma-separated emails that get the "admin" role on first login.
# Everyone else who logs in becomes a "client".
ADMIN_EMAILS="you@example.com"

# Public base URL, used in emails.
APP_URL="http://localhost:3000"

# SMTP config for sending OTP emails. If left unset in development, OTP
# codes are logged to the server console instead of emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FoodFlow <no-reply@foodflow.app>"
