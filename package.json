{
  "name": "foodflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke.test.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "auth:migrate-users": "tsx scripts/migrate-users.ts",
    "db:studio": "prisma studio",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "security:check": "node scripts/security-check.mjs",
    "grant:platform-admin": "node scripts/grant-platform-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcrypt": "6.0.0",
    "framer-motion": "^12.23.12",
    "jose": "^6.2.10",
    "next": "15.5.24",
    "node-forge": "^1.4.0",
    "nodemailer": "10.0.12",
    "prisma": "6.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.4",
    "undici": "^6.28.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcrypt": "6.0.0",
    "@types/node": "^20.17.6",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.28",
    "tailwindcss": "^4.1.13",
    "tsx": "4.23.13",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
