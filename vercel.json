{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/billing/retry-emissions",
      "schedule": "10 7 * * *"
    },
    {
      "path": "/api/cron/billing/send-emails",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/billing/backup-cdrs",
      "schedule": "20 7 * * *"
    },
    {
      "path": "/api/cron/subscriptions",
      "schedule": "30 7 * * *"
    }
  ]
}
